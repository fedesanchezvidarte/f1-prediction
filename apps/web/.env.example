# Copy this file to .env.local and fill in your Supabase project's values.
# Both are publishable (they ship in the browser bundle); data access is
# protected by Row Level Security. Find them in the Supabase dashboard
# under Settings -> API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
