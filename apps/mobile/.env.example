# Copy this file to .env and fill in your Supabase project's values.
# EXPO_PUBLIC_ vars are inlined into the app bundle — only publishable
# values belong here; data access is protected by Row Level Security.
# Find them in the Supabase dashboard under Settings -> API.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
